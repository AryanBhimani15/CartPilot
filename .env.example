# CartPilot AI — copy to .env and fill in. NEVER commit .env.
# Every value below is fake. Required vars have no application default:
# a missing one must crash the API at startup (see ARCHITECTURE.md §12).

# ---- Core ----
APP_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Database (D-003: local Postgres 14, no Docker) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cartpilot

# ---- Security ----
# Used to mint cart-bound payment confirmation tokens (D-008). 32+ random bytes.
CONFIRMATION_TOKEN_SECRET=replace-me-with-openssl-rand-hex-32

# ---- LLM (D-006) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ---- Embeddings (D-005) ----
# `deterministic` needs no key and is what pytest/eval use by default.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=REPLACE_ME_VERIFY_AGAINST_PROVIDER_DOCS
EMBEDDING_API_KEY=
EVAL_USE_REAL_EMBEDDINGS=0

# ---- Vector index (D-004) ----
VECTOR_BACKEND=numpy   # numpy | pgvector

# ---- Razorpay TEST MODE ONLY (D-009) ----
# key_id is the only one that may ever reach the browser.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
RAZORPAY_RECONCILE_POLL_SECONDS=5

# ---- Frontend (NEXT_PUBLIC_* is exposed to the browser — key_id only) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
